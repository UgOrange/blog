---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("en");
const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((post) => post.id.startsWith("en/"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={t("site.title")} description={t("site.description")} /></head>
  <body>
    <Header />
    <main>
      <section class="home-intro">
        <p class="shell-label">{t("home.eyebrow")}</p>
        <h1>{t("home.welcome")}</h1>
        <p class="intro-copy">{t("home.intro")}</p>
        <p class="topic-line">{t("home.topics")}</p>
      </section>

      <section class="recent-posts" aria-labelledby="recent-heading">
        <div class="section-header">
          <h2 id="recent-heading">{t("home.recent")}</h2>
          <a href="/en/blog">{t("home.viewAll")} <span aria-hidden="true">→</span></a>
        </div>
        <ol class="post-stream">
          {posts.map((post) => (
            <li>
              <a href={`/en/blog/${post.id.replace("en/", "")}/`}>
                <time><FormattedDate date={post.data.pubDate} /></time>
                <div class="post-copy">
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
                <span class="post-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main { padding-top: clamp(5.5rem, 12vw, 8.5rem); }
  .home-intro { max-width: 760px; }
  .home-intro h1 { max-width: 720px; margin-bottom: 1.7rem; overflow-wrap: anywhere; }
  .intro-copy { max-width: 650px; color: var(--text-body); font-size: 1.08rem; line-height: 1.75; }
  .topic-line { margin-top: 1.75rem; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; }
  .recent-posts { margin-top: clamp(5rem, 11vw, 7.5rem); }
  .section-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.9rem; border-bottom: 1px solid var(--border); }
  .section-header h2 { margin: 0; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase; }
  .section-header a { font-family: var(--font-mono); font-size: 0.7rem; text-decoration: none; }
  .post-stream { margin: 0; padding: 0; list-style: none; }
  .post-stream li { border-bottom: 1px solid var(--border-soft); }
  .post-stream a { display: grid; grid-template-columns: 112px 1fr 24px; gap: 1.5rem; padding: 1.7rem 0; color: inherit; text-decoration: none; }
  .post-stream time { padding-top: 0.3rem; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.7rem; white-space: nowrap; }
  .post-copy { min-width: 0; }
  .post-copy h3 { margin: 0 0 0.4rem; overflow-wrap: anywhere; font-size: 1.25rem; transition: color 160ms ease; }
  .post-copy p { max-width: 650px; margin: 0; color: var(--text-muted); font-size: 0.9rem; line-height: 1.55; }
  .post-arrow { color: var(--accent); }
  .post-stream a:hover h3 { color: var(--accent-strong); }
  .post-stream a:hover .post-arrow { transform: translate(2px, -2px); }
  @media (max-width: 620px) {
    .post-stream a { grid-template-columns: 76px 1fr; gap: 0.8rem; padding: 1.4rem 0; }
    .post-arrow, .post-copy p { display: none; }
    .post-copy h3 { font-size: 1.04rem; line-height: 1.4; }
    .topic-line { overflow-wrap: anywhere; line-height: 1.9; }
  }
</style>
