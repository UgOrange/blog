---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("zh");
const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((post) => post.id.startsWith("zh/") || (!post.id.startsWith("en/") && !post.id.includes("/")))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh">
  <head><BaseHead title={t("blog.title")} description={t("blog.description")} /></head>
  <body>
    <Header />
    <main>
      <header class="archive-header">
        <p class="shell-label">INDEX / {String(posts.length).padStart(2, "0")} ENTRIES</p>
        <h1 class="page-heading">{t("blog.title")}</h1>
        <p>{t("blog.description")}</p>
      </header>

      <ol class="archive-list">
        {posts.map((post) => (
          <li class="archive-entry">
            <a href={`/blog/${post.id.replace("zh/", "")}/`}>
              <time><FormattedDate date={post.data.pubDate} /></time>
              <div class="entry-copy">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <ul class="tags" aria-label="文章标签">
                    {post.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </main>
    <Footer />
  </body>
</html>

<style>
  .archive-header { max-width: 680px; margin-bottom: 5rem; }
  .archive-header p:last-child { color: var(--text-muted); }
  .archive-list { margin: 0; padding: 0; border-top: 1px solid var(--border); list-style: none; }
  .archive-entry { border-bottom: 1px solid var(--border-soft); }
  .archive-entry > a { display: grid; grid-template-columns: 116px 1fr 28px; gap: 1.6rem; padding: 2rem 0; color: inherit; text-decoration: none; }
  time { padding-top: 0.25rem; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.7rem; white-space: nowrap; }
  .entry-copy { min-width: 0; }
  .entry-copy h2 { margin: 0 0 0.65rem; overflow-wrap: anywhere; font-size: clamp(1.2rem, 3vw, 1.55rem); transition: color 160ms ease; }
  .entry-copy > p { max-width: 680px; margin: 0; color: var(--text-muted); font-size: 0.92rem; line-height: 1.62; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.7rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .tags li { color: var(--accent); font-family: var(--font-mono); font-size: 0.63rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .arrow { color: var(--accent); }
  .archive-entry a:hover h2 { color: var(--accent-strong); }
  .archive-entry a:hover .arrow { transform: translate(2px, -2px); }
  @media (max-width: 620px) {
    .archive-header { margin-bottom: 3.5rem; }
    .archive-entry > a { grid-template-columns: 76px 1fr; gap: 0.8rem; padding: 1.6rem 0; }
    .arrow, .entry-copy > p { display: none; }
    .entry-copy h2 { font-size: 1.08rem; line-height: 1.4; }
    .tags { margin-top: 0.75rem; }
  }
</style>
