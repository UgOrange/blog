---
import { NAV_LINKS, AUTHOR } from "../consts";
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils";
import HeaderLink from "./HeaderLink.astro";

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const navLinks = NAV_LINKS[lang].filter((link) => link.href !== "/" && link.href !== "/en");
---

<header class="site-header">
  <nav aria-label={lang === "zh" ? "主导航" : "Primary navigation"}>
    <a class="brand" href={lang === "zh" ? "/" : "/en/"} aria-label="ugorange.com home">
      <span>ugorange.com</span>
    </a>

    <div class="nav-links">
      {navLinks.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
      <a class="github-link" href={`https://github.com/${AUTHOR.github}`} target="_blank" rel="noreferrer">GitHub</a>
      <span class="divider" aria-hidden="true"></span>
      <a
        class="language-link"
        href={getLocalizedPath(currentPath, lang === "zh" ? "en" : "zh")}
        aria-label={lang === "zh" ? "Switch to English" : "切换到中文"}
      >
        {lang === "zh" ? "EN" : "中文"}
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
  }

  nav {
    display: flex;
    min-width: 0;
    width: min(var(--content-width), calc(100% - 48px));
    height: 68px;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    flex-shrink: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .nav-links { display: flex; min-width: 0; align-items: center; gap: 1.7rem; }
  .nav-links :global(a) {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-decoration: none;
  }
  .nav-links :global(a:hover),
  .nav-links :global(a.active) { color: var(--text); }
  .language-link { color: var(--accent) !important; }
  .divider { width: 1px; height: 14px; background: var(--border); }

  @media (max-width: 620px) {
    nav { width: calc(100% - 40px); height: 60px; }
    .nav-links { gap: 1rem; }
    .github-link,
    .divider { display: none; }
    .nav-links :global(a:nth-child(2)) { display: none; }
  }

  @media (max-width: 390px) {
    .nav-links :global(a) { font-size: 0.68rem; }
    .brand { font-size: 0.76rem; }
  }
</style>
