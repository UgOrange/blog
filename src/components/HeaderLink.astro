---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
const normalize = (value: string) => value.replace(/\/$/, "") || "/";
const pathname = normalize(Astro.url.pathname);
const target = normalize(String(href));
const isActive = target === "/" ? pathname === "/" : pathname === target || pathname.startsWith(`${target}/`);
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? "page" : undefined} {...props}>
  <slot />
</a>

<style>
  a {
    position: relative;
    display: inline-block;
    text-decoration: none;
  }

  a::after {
    position: absolute;
    right: 0;
    bottom: -0.48rem;
    left: 0;
    height: 1px;
    background: var(--accent);
    content: "";
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  a.active::after {
    opacity: 1;
    transform: scaleX(1);
  }
</style>
