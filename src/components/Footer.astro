---
import { AUTHOR } from "../consts";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <span>© {today.getFullYear()} {AUTHOR.name.toUpperCase()}</span>
    <nav aria-label={lang === "zh" ? "页脚链接" : "Footer links"}>
      <a href={`https://github.com/${AUTHOR.github}`} target="_blank" rel="noreferrer">GitHub</a>
      <a href={`mailto:${AUTHOR.email}`}>Email</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border); }
  .footer-inner {
    display: flex;
    width: min(var(--content-width), calc(100% - 48px));
    min-height: 88px;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }
  nav { display: flex; gap: 1.4rem; }
  a { color: var(--text-muted); text-decoration: none; }
  a:hover { color: var(--accent); }

  @media (max-width: 620px) {
    .footer-inner {
      width: calc(100% - 40px);
      min-height: 110px;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 0.85rem;
    }
  }
</style>
